{
  "name": "zentiq-pos",
  "version": "1.6.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "build:apk": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile preview",
    "electron": "electron electron/main.js",
    "build:windows": "expo export -p web && electron-builder --win",
    "build:windows:portable": "expo export -p web && electron-builder --win portable",
    "print-bridge": "node electron/print-bridge.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.12",
    "babel-preset-expo": "~57.0.0",
    "expo": "~58.0.19",
    "expo-file-system": "~58.0.11",
    "expo-print": "~58.0.0",
    "expo-sharing": "~58.0.20",
    "expo-status-bar": "~58.0.4",
    "firebase": "^12.12.1",
    "lucide-react-native": "^1.14.0",
    "nativewind": "^2.0.11",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.75.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-tcp-socket": "^6.4.1",
    "react-native-web": "~0.21.4",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.4",
    "tailwindcss": "3.3.2",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-tcp-socket"
        ]
      }
    }
  },
  "build": {
    "appId": "com.zentiq.pos",
    "productName": "Zentiq POS",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zentiq POS"
    },
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "publish": null
  },
  "description": "Zentiq Restaurant Point of Sale & Billing Terminal",
  "author": "Zentiq"
}
